# ============================================================
# Hermes Agent - Environment Variables (Secrets)
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Provider API Keys ---
# Only set the ones you need based on your provider choice in config.yaml
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NOUS_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
KIMI_API_KEY=
GH_TOKEN=
GITHUB_TOKEN=

# --- Telegram Bot Configuration ---
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID (get it from @userinfobot)
# Comma-separated for multiple authorized users
TELEGRAM_ALLOWED_USERS=

# --- Optional: Telegram Webhook (for cloud deployments) ---
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_PORT=8443

# --- Optional: Telegram Proxy ---
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# --- Optional: Home Channel for cron deliveries ---
# TELEGRAM_HOME_CHANNEL=-1001234567890
# TELEGRAM_HOME_CHANNEL_NAME="My Notes"

# --- Optional: API Server (exposed on port 8642) ---
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_KEY=change-me-to-a-secure-key
API_SERVER_CORS_ORIGINS=*

# --- HuggingFace (for faster-whisper model downloads) ---
# HF_TOKEN=hf_xxx

# --- Optional: Docker Terminal Backend ---
# If using docker as terminal backend inside the container
# TERMINAL_DOCKER_VOLUMES=["/host/path:/container/path"]

# ============================================================
# Hermes WebUI Configuration
# ============================================================
# Optional password protection (recommended if exposed beyond localhost)
# HERMES_WEBUI_PASSWORD=change-me-to-something-strong

# Workspace directory for the WebUI file browser (default: ~/workspace)
# HERMES_WORKSPACE=/home/ben/projects

# Optional: Gateway-backed browser chat (uses existing agent gateway instead of in-process)
# HERMES_WEBUI_CHAT_BACKEND=gateway
# HERMES_WEBUI_GATEWAY_BASE_URL=http://hermes:8642
# HERMES_WEBUI_GATEWAY_API_KEY=${API_SERVER_KEY}
