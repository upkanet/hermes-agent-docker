# ============================================================
# Hermes Agent - .gitignore (hygiene + secrets)
# ============================================================

# --- Secrets / credentials ---
config/.env
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.kdbx
secrets/
credentials/

# --- Runtime data (never commit) ---
data_runtime/
data_archive/
backups/

# Legacy runtime dir (keep folder placeholder only)
data/*
!data/.gitkeep

# Hermes sensitive runtime artifacts (defense in depth)
**/auth.json
**/auth.json.corrupt
**/memories/
**/sessions/
**/logs/
**/state.db
**/state.db-*
**/todos.db
**/response_store.db
**/kanban.db

# --- Databases / local state ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Logs / caches / temp ---
*.log
logs/
log/
.cache/
cache/
tmp/
temp/
*.tmp
*.cache

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.Python
build/
dist/
.eggs/
*.egg-info/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- IDE / OS ---
.vscode/
.idea/
.cursor/
.codegraph/
*.swp
*.swo
*~
.DS_Store

# --- Lock / pid ---
*.lock
*.pid

# Project-specific exclusions
plugins/model-providers/copilot/

# Keep placeholders
!.gitkeep
